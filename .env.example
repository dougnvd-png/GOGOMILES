# Copie este arquivo para .env.local e preencha os valores.
# Sem nenhum valor, o projeto abre em modo demonstração.

# Login (Clerk): painel do Clerk > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Banco de dados (Supabase): botão Connect > ORMs > Drizzle > Transaction pooler
DATABASE_URL=

# E-mail (Resend): painel do Resend > API Keys
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend. Vazio usa onboarding@resend.dev, que só envia para o seu próprio e-mail.
EMAIL_FROM=
